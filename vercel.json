{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?route=:path*" }],
  "functions": {
    "api/index.js": { "includeFiles": "{questions/**,course.json}" }
  }
}
